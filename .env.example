# FabRich + Embedded TauricResearch TradingAgents Configuration
# Copy this file to .env and fill in your actual API keys. Never commit .env!

# Primary LLM Provider Keys (Required for Tauric AI Gate)
GOOGLE_API_KEY=your-google-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
NVIDIA_API_KEY=your-nvidia-api-key-here
META_API_KEY=your-meta-api-key-here
GROQ_API_KEY=your-groq-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Service Ports & Networking
PORT=3000
TAURIC_PORT=8000
TAURIC_HOST=127.0.0.1
TRADINGAGENTS_HYBRID_TIMEOUT_S=600

# Optional Financial & News APIs
FINANCIAL_DATASETS_API_KEY=your-financial-datasets-key
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
FRED_API_KEY=your-fred-api-key
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret